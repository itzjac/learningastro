---
import { Image } from "astro:assets";
const { author } = Astro.props;
---

<section class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div class="max-w-lg mx-auto my-10 bg-white rounded-lg shadow-md p-5">
        <Image
          class="w-32 h-32 rounded-full mx-auto"
          src={author.data.avatar}
          alt={author.data.name}
          width={200}
          height={200}
        />
        <h2 class="text-center text-2xl font-semibold mt-3">{author.data.name}</h2>
        <p class="text-center text-gray-600 mt-1">{author.data.subtitle}</p>
        <div class="flex justify-center mt-5">
            <a href={`https://x.com/${author.data.twitter}`} class="text-blue-500 hover:text-blue-700 mx-3">{author.data.twitter}</a>
            <a href={`https://linkedin.com/${author.data.linkedIn}`} class="text-blue-500 hover:text-blue-700 mx-3">{author.data.linkedin}</a>
            <a href={`https://github.com/${author.data.github}`} class="text-blue-500 hover:text-blue-700 mx-3">{author.data.github}</a>
        </div>
        <div class="mt-5">
            <h3 class="text-xl font-semibold">Bio</h3>
            <p class="text-gray-600 mt-2">{author.data.bio}</p>
            <div class="flex justify-end">
                <a href={`../blog/${author.id}`}> Read more </a>
            </div>
        </div>
    </div>
    
</section>