---
//import BlogPost from "../components/BlogPost.astro"
//const posts = await Astro.glob('./posts/*.{md,mdx}');

import TypeBlogPost from "../components/TypeBlogPost.astro"

import { getCollection } from "astro:content"
import MainLayout from "../layouts/MainLayout.astro"
import { siteConfig } from "../styles/config/side-config"

const blogPosts = await getCollection('blog');
---

<MainLayout title="Blog">
<section class="bg-white dark:bg-gray-900">
    <div class="container px-6 py-10 mx-auto">
        <h1 class="text-2xl font-semibold text-gray-800 capitalize lg:text-3xl dark:text-white">{siteConfig.title}</h1>
        <div class="grid grid-cols-1 gap-8 mt-8 md:mt-16 md:grid-cols-2">
            {blogPosts.map( (post) => <TypeBlogPost post= {post} />)}
        </div>
    </div>
</section>

</MainLayout>